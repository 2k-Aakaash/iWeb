{
  "manifest_version": 3,
  "name": "iWeb React",
  "version": "1.0.0.2",
  "description": "iWeb: Individualized Web Interface - React Edition.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.met.no/*",
    "https://nominatim.openstreetmap.org/*",
    "https://ipapi.co/*",
    "https://api.unsplash.com/*",
    "https://images.unsplash.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://objects.githubusercontent.com/*",
    "https://release-assets.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "version_name": "v1.0.0-build.2"
}
